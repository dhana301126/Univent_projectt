# ==========================================
# 1. DATABASE CONFIGURATION (Single MongoDB URI for all backend services)
# ==========================================
# Used in: auth-service, event-service, leaderboard-service, notification-service, settings-service
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/univent?retryWrites=true&w=majority

# ==========================================
# 2. JWT CONFIGURATION
# ==========================================
# Used in: auth-service, and any service validating tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=7d

# ==========================================
# 3. EMAIL CONFIGURATION (auth-service)
# ==========================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Univent Support <support@univent.com>"

# ==========================================
# 4. API GATEWAY CONFIGURATION (Render)
# ==========================================
PORT=8000
CLIENT_URL=https://your-frontend.vercel.app
AUTH_SERVICE=https://your-auth-service.onrender.com
EVENT_SERVICE=https://your-event-service.onrender.com
NOTIFICATION_SERVICE=https://your-notification-service.onrender.com
LEADERBOARD_SERVICE=https://your-leaderboard-service.onrender.com
SETTINGS_SERVICE=https://your-settings-service.onrender.com

# ==========================================
# 5. FRONTEND CONFIGURATION (Vercel)
# ==========================================
# Set these in your Vercel Frontend Project -> Settings -> Environment Variables
VITE_API_GATEWAY_URL=https://your-gateway.onrender.com
VITE_NOTIFICATION_SERVICE_URL=https://your-notification-service.onrender.com
